# ─── Server ───────────────────────────────────────────
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── MongoDB ──────────────────────────────────────────
MONGODB_URI=your_mongoDB_URI
DB_NAME=careers-nitkkr

# ─── JWT ──────────────────────────────────────────────
ACCESS_TOKEN_SECRET=your-access-token-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRY=7d

# ─── Cloudinary ───────────────────────────────────────
# Get keys from: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email / SendGrid ─────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=your-verified-gmail@gmail.com

# ─── Stripe ───────────────────────────────────────────
# Get keys from: https://dashboard.stripe.com/apikeys
# Use "Test Mode" keys during development (prefix: sk_test_ / pk_test_)
# Use "Live Mode" keys in production (prefix: sk_live_ / pk_live_)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx

# ─── File Upload ──────────────────────────────────────
MAX_FILE_SIZE=10485760   # 10MB in bytes
UPLOAD_TMP_DIR=tmp/uploads
